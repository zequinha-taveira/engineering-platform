# ===================================
# Engineering Platform — Environment Template
# ===================================
# Este arquivo documenta TODAS as variáveis de ambiente aceitas
# pela plataforma, com regras de validação e nível de criticidade.
#
# 🔴 CRITICAL — Vazamento causa comprometimento total do sistema
# 🟡 HIGH     — Vazamento expõe dados ou serviços internos
# 🟢 LOW      — Configurações operacionais sem risco direto
#
# Para gerar valores seguros:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ===================================

# -----------------------------------
# MCP Server [🟢 LOW]
# -----------------------------------
# Porta e host do servidor MCP local
MCP_SERVER_PORT=         # number   | default: 3000
MCP_SERVER_HOST=         # string   | default: localhost
MCP_LOG_LEVEL=           # enum     | info | debug | warn | error

# -----------------------------------
# Database [🔴 CRITICAL]
# -----------------------------------
# Connection string completa (inclui user, password, host, port, dbname)
# Formato: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=            # string   | REQUIRED
DATABASE_SSL=            # boolean  | default: true
DATABASE_POOL_MIN=       # number   | default: 2
DATABASE_POOL_MAX=       # number   | default: 10

# -----------------------------------
# Authentication — JWT [🔴 CRITICAL]
# -----------------------------------
# Secret para assinar tokens JWT. Mínimo 32 caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=              # string   | REQUIRED | min: 32 chars
JWT_EXPIRATION=          # string   | default: 15m
JWT_REFRESH_EXPIRATION=  # string   | default: 7d
JWT_ALGORITHM=           # enum     | RS256 | HS256 | default: RS256

# -----------------------------------
# API Keys — Payment Gateway [🔴 CRITICAL]
# -----------------------------------
STRIPE_SECRET_KEY=       # string   | REQUIRED | starts with sk_
STRIPE_WEBHOOK_SECRET=   # string   | REQUIRED | starts with whsec_
STRIPE_PUBLISHABLE_KEY=  # string   | starts with pk_

# -----------------------------------
# API Keys — Email [🟡 HIGH]
# -----------------------------------
SENDGRID_API_KEY=        # string   | starts with SG.
EMAIL_FROM=              # email    | default: noreply@example.com

# -----------------------------------
# Cloud — AWS [🔴 CRITICAL]
# -----------------------------------
AWS_ACCESS_KEY_ID=       # string   | 20 chars
AWS_SECRET_ACCESS_KEY=   # string   | 40 chars
AWS_REGION=              # string   | default: us-east-1
AWS_S3_BUCKET=           # string   | bucket name

# -----------------------------------
# Cloud — GCP [🔴 CRITICAL] (alternativa)
# -----------------------------------
# GOOGLE_APPLICATION_CREDENTIALS=  # filepath | service account JSON
# GCP_PROJECT_ID=                  # string

# -----------------------------------
# Cloud — Azure [🔴 CRITICAL] (alternativa)
# -----------------------------------
# AZURE_TENANT_ID=       # uuid
# AZURE_CLIENT_ID=       # uuid
# AZURE_CLIENT_SECRET=   # string

# -----------------------------------
# Redis / Cache [🟡 HIGH]
# -----------------------------------
REDIS_URL=               # string   | default: redis://localhost:6379
REDIS_PASSWORD=          # string   | REQUIRED em produção
REDIS_TLS=               # boolean  | default: false (true em produção)

# -----------------------------------
# Observability [🟡 HIGH]
# -----------------------------------
SENTRY_DSN=              # url      | Sentry DSN para error tracking
OTEL_EXPORTER_OTLP_ENDPOINT=  # url | OpenTelemetry collector

# -----------------------------------
# Security Settings [🟡 HIGH]
# -----------------------------------
RATE_LIMIT_WINDOW_MS=    # number   | default: 60000 (1 min)
RATE_LIMIT_MAX_REQUESTS= # number   | default: 100
CORS_ALLOWED_ORIGINS=    # string   | comma-separated URLs
ENCRYPTION_KEY=          # hex      | 32 bytes hex | REQUIRED
ENCRYPTION_ALGORITHM=    # enum     | aes-256-gcm | default: aes-256-gcm

# -----------------------------------
# CI/CD & Automation [🟡 HIGH]
# -----------------------------------
# GITHUB_TOKEN=          # string   | starts with ghp_
# DOCKER_REGISTRY_URL=   # url
# DOCKER_REGISTRY_USER=  # string
# DOCKER_REGISTRY_PASSWORD= # string

# -----------------------------------
# Feature Flags [🟢 LOW]
# -----------------------------------
FEATURE_MFA_ENABLED=     # boolean  | default: false
FEATURE_AUDIT_LOG_ENABLED= # boolean | default: true
