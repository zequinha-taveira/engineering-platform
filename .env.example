# ===================================
# Engineering Platform — Environment Variables
# ===================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env com valores reais.
#
# cp .env.example .env
# ===================================

# -----------------------------------
# 🔒 MCP Server
# -----------------------------------
MCP_SERVER_PORT=3000
MCP_SERVER_HOST=localhost
MCP_LOG_LEVEL=info

# -----------------------------------
# 🔒 Database
# -----------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/engineering_platform
DATABASE_SSL=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# -----------------------------------
# 🔒 Authentication (JWT)
# -----------------------------------
JWT_SECRET=CHANGE_ME_USE_MINIMUM_32_CHARS_RANDOM_STRING
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ALGORITHM=RS256

# -----------------------------------
# 🔒 API Keys (External Services)
# -----------------------------------
# Stripe
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME

# SendGrid / Email
SENDGRID_API_KEY=SG.CHANGE_ME
EMAIL_FROM=noreply@example.com

# -----------------------------------
# 🔒 Cloud Provider
# -----------------------------------
# AWS
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=us-east-1
AWS_S3_BUCKET=engineering-platform-assets

# GCP (alternativa)
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account.json
# GCP_PROJECT_ID=my-project

# Azure (alternativa)
# AZURE_TENANT_ID=CHANGE_ME
# AZURE_CLIENT_ID=CHANGE_ME
# AZURE_CLIENT_SECRET=CHANGE_ME

# -----------------------------------
# 🔒 Redis / Cache
# -----------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=CHANGE_ME
REDIS_TLS=false

# -----------------------------------
# 🔒 Observability
# -----------------------------------
SENTRY_DSN=https://CHANGE_ME@sentry.io/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# -----------------------------------
# 🔒 Security Settings
# -----------------------------------
# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Encryption
ENCRYPTION_KEY=CHANGE_ME_USE_32_BYTE_HEX_STRING
ENCRYPTION_ALGORITHM=aes-256-gcm

# -----------------------------------
# 🔒 CI/CD & Automation
# -----------------------------------
# GitHub (para automação)
# GITHUB_TOKEN=ghp_CHANGE_ME

# Docker Registry
# DOCKER_REGISTRY_URL=ghcr.io/org
# DOCKER_REGISTRY_USER=CHANGE_ME
# DOCKER_REGISTRY_PASSWORD=CHANGE_ME

# -----------------------------------
# Feature Flags
# -----------------------------------
FEATURE_MFA_ENABLED=false
FEATURE_AUDIT_LOG_ENABLED=true
