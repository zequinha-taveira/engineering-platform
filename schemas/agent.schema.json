{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Definition Schema",
  "description": "Schema for validating AI agent definitions in the Engineering Platform",
  "type": "object",
  "required": ["name", "role", "responsibilities", "inputs", "outputs"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Agent name (e.g., Planner, Architect, Developer)"
    },
    "role": {
      "type": "string",
      "description": "Brief description of the agent's role"
    },
    "phase": {
      "type": "string",
      "enum": ["P", "R", "E", "V", "C", "P/R", "R/V", "E/C", "all"],
      "description": "PREVC phase(s) where this agent operates"
    },
    "responsibilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "List of agent responsibilities"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Input artifacts the agent expects"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Output artifacts the agent produces"
    },
    "promptTemplates": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths to prompt templates used by this agent"
    },
    "contextResources": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Platform resources the agent needs access to"
    },
    "handoffs": {
      "type": "object",
      "properties": {
        "receivesFrom": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["agent", "artifact"],
            "properties": {
              "agent": { "type": "string" },
              "artifact": { "type": "string" }
            }
          }
        },
        "sendsTo": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["agent", "artifact"],
            "properties": {
              "agent": { "type": "string" },
              "artifact": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
