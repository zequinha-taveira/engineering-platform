{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Development Plan Schema",
  "description": "Schema for validating development plans in the Engineering Platform",
  "type": "object",
  "required": ["name", "summary", "phases"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Feature or plan name"
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "description": "Brief description of what will be implemented and why"
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": { "type": "string" },
          "completed": { "type": "boolean", "default": false }
        }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "included": { "type": "array", "items": { "type": "string" } },
        "excluded": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["internal", "external"] },
          "status": { "type": "string", "enum": ["available", "in-progress", "blocked"] }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "tasks"],
        "properties": {
          "name": { "type": "string" },
          "duration": { "type": "string" },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["description"],
              "properties": {
                "description": { "type": "string" },
                "assignee": { "type": "string" },
                "estimate": { "type": "string" },
                "completed": { "type": "boolean", "default": false },
                "acceptance": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "probability", "impact"],
        "properties": {
          "description": { "type": "string" },
          "probability": { "type": "string", "enum": ["high", "medium", "low"] },
          "impact": { "type": "string", "enum": ["high", "medium", "low"] },
          "mitigation": { "type": "string" }
        }
      }
    },
    "successCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": { "type": "string" },
          "met": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
