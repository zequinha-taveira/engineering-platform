{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Constitution Schema",
  "description": "Schema for validating Engineering Platform constitution documents",
  "type": "object",
  "required": ["version", "status", "principles", "governance"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the constitution (MAJOR.MINOR.PATCH)"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated"],
      "description": "Current status of the constitution"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date",
      "description": "Date of last update (YYYY-MM-DD)"
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Principle name"
          },
          "description": {
            "type": "string",
            "description": "Principle description"
          }
        }
      },
      "description": "Fundamental principles that guide the project"
    },
    "governance": {
      "type": "object",
      "properties": {
        "decisions": {
          "type": "object",
          "properties": {
            "requireADR": { "type": "boolean", "default": true },
            "requireReview": { "type": "boolean", "default": true }
          }
        },
        "codeReview": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean", "default": true },
            "checks": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "versioning": {
          "type": "object",
          "properties": {
            "commitConvention": {
              "type": "string",
              "enum": ["conventional-commits", "angular", "custom"],
              "default": "conventional-commits"
            },
            "branchStrategy": {
              "type": "string",
              "enum": ["git-flow", "trunk-based", "github-flow"],
              "default": "trunk-based"
            }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "properties": {
        "testCoverage": {
          "type": "object",
          "properties": {
            "minimum": { "type": "number", "minimum": 0, "maximum": 100, "default": 80 },
            "critical": { "type": "number", "minimum": 0, "maximum": 100, "default": 100 }
          }
        },
        "documentation": {
          "type": "object",
          "properties": {
            "requireReadme": { "type": "boolean", "default": true },
            "requireApiSpec": { "type": "boolean", "default": true },
            "requireADR": { "type": "boolean", "default": true }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "inputValidation": { "type": "boolean", "default": true },
        "noSecretsInCode": { "type": "boolean", "default": true },
        "auditFrequency": {
          "type": "string",
          "enum": ["daily", "weekly", "monthly", "quarterly"],
          "default": "monthly"
        }
      }
    }
  }
}
